node_modules/
*.log
.DS_Store
# Generated images must never be committed.
generated-images/
# Python bytecode is machine-local (it lands under resources/): never ship it.
__pycache__/
*.pyc

# Test-harness build output: not shipped in the package, not committed.
testlib/

# Frontend visual-preview page generated by test/preview-frontend.mjs.
test/client-preview.html

# Codegraph index: a machine-local code index, never committed.
.codegraph/

# Local working plans / status archive: read locally, never committed. Not in `files`, so never packed.
docs/plans/

# Playwright CLI scratch (local QA only).
.playwright-cli/
