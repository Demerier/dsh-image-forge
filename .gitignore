node_modules/
*.log
.DS_Store
# Generated images must never be committed.
generated-images/
# Python bytecode is machine-local (it lands under resources/): never ship it.
__pycache__/
*.pyc

# Test-harness build output: not shipped in the package, not committed.
testlib/

# Frontend visual-preview page generated by test/preview-frontend.mjs.
test/client-preview.html

# Codegraph index: a machine-local code index, never committed.
.codegraph/

# Local working plans / status archive: read locally, never committed. Not in `files`, so never packed.
docs/plans/

# Playwright CLI scratch (local QA only).
.playwright-cli/

# npm pack output
*.tgz

# WorkBuddy workspace data (memory / session state): machine-local, never committed.
.workbuddy/

# Mimocode scheduled-task state (locks, pids, machine-local): never committed.
.mimocode/

# Verification reports and screenshots are not vendored: the shipped prose keeps
# the claims, the raw captures stay out of the repository (and its history).
docs/evidence/

# Live preview harness scratch: generated images and screenshots (test/preview-*.mjs).
.preview/

# Blind-comparison samples (test/blind-*.mjs): ~15 MB of generated PNGs used to
# score base vs turbo. Evidence for a judgement already recorded in prose, same
# treatment as docs/evidence/ — the claim stays, the captures do not.
.blindtest/

# Mimosa scanner state (machine-local scan history / indexes): never committed.
.mimosa/

# 宣传片等工作产物：machine-local working material, never committed.
输出/
