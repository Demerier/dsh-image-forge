{
  "name": "dsh-image-forge",
  "version": "0.4.0",
  "description": "DSH 本机图像生成 / 参考图编辑插件：通过 ComfyUI 支持 Qwen-Image 2.1 与 MOSS-Image，模型由 comfyModel 选择；成果按画板归档。",
  "license": "MIT",
  "author": "Demerier",
  "homepage": "https://github.com/Demerier/dsh-image-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demerier/dsh-image-forge.git"
  },
  "bugs": {
    "url": "https://github.com/Demerier/dsh-image-forge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "qwen",
    "qwen-image",
    "moss-image",
    "text-to-image",
    "image-edit",
    "image-generation",
    "comfyui"
  ],
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts/comfyui-discovery.mjs",
    "scripts/start-comfyui.mjs",
    "cordis.yml",
    "README.md",
    "skill.md",
    "references",
    "docs/client-bundle.md",
    "docs/comfyui-deployment.md",
    "docs/configuration.md",
    "docs/license-and-limits.md",
    "docs/local-install.md",
    "docs/release-notes-0.2.0.md",
    "docs/release-notes-0.3.0.md",
    "docs/release-notes-0.4.0.md",
    "docs/testing.md",
    "docs/usage-reference.md",
    "docs/images/repo-banner.png",
    "docs/images/studio-assets.png",
    "docs/images/studio-workbench.png",
    "LICENSE",
    "THIRD-PARTY"
  ],
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts",
    "test": "node test/ratio.test.mjs && node test/surface.test.mjs && node test/comfyui-e2e.test.mjs && node test/edit-e2e.test.mjs && node test/moss-edit.test.mjs && node test/settings.test.mjs && node --test-force-exit test/studio.test.mjs && node test/canvas-flow-model.test.mjs && node test/studio-canvas.test.mjs && node test/boards.test.mjs && node test/board-migration.test.mjs && node test/output.test.mjs && node test/package-contents.test.mjs && node test/studio-file-route.test.mjs && node test/studio-log-route.test.mjs && node test/model-profiles.test.mjs && node test/progress.test.mjs && node test/runs.test.mjs && node test/environment.test.mjs && node test/layout-editor.test.mjs && node test/studio-lineage.test.mjs && node test/canvas-interactions.test.mjs && node test/canvas-connections.test.mjs && node test/canvas-export.test.mjs && node test/moss-layout.test.mjs && node test/mcp-backend.test.mjs && node test/workbench-tabs.test.mjs && node test/workbench-workspace.test.mjs && node test/workbench-shell.test.mjs && node test/docs-consistency.test.mjs && node test/bundle-xyflow.test.mjs && node test/blind-pe.test.mjs",
    "test:live": "node test/live-generate-e2e.mjs",
    "test:live:edit": "node test/live-edit-e2e.mjs",
    "comfy": "node scripts/start-comfyui.mjs",
    "comfy:doctor": "node scripts/start-comfyui.mjs --doctor",
    "comfy:stop": "node scripts/start-comfyui.mjs --stop",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm test",
    "blind:turbo": "node test/blind-turbo.mjs",
    "blind:page": "node test/blind-regen.mjs && node test/blind-score-check.mjs",
    "blind:pe": "node test/blind-pe.mjs",
    "blind:pe:audit": "node test/blind-pe.mjs audit",
    "blind:pe:generate": "node test/blind-pe.mjs generate",
    "blind:pe:score": "node test/blind-pe.mjs score",
    "blind:pe:check": "node test/blind-pe.mjs check",
    "blind:pe2": "node test/blind-pe.mjs audit --round v2",
    "blind:pe2:audit": "node test/blind-pe.mjs audit --round v2",
    "blind:pe2:generate": "node test/blind-pe.mjs generate --round v2",
    "blind:pe2:score": "node test/blind-pe.mjs score --round v2",
    "blind:pe2:check": "node test/blind-pe.mjs check --round v2",
    "blind:pe2:analyze": "node test/blind-pe.mjs analyze --round v2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@xyflow/react": "^12.12.1",
    "tsdown": "0.22.14",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
