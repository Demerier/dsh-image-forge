{
  "name": "dsh-image-forge",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: Qwen-Image 文生图 / 参考图编辑，把官方提示词契约的 wh_ratio 做成一等参数；后端 local（本插件自带受管运行时）/ comfyui / api，默认 auto",
  "license": "MIT",
  "author": "Demerier",
  "homepage": "https://github.com/Demerier/dsh-image-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demerier/dsh-image-forge.git"
  },
  "bugs": {
    "url": "https://github.com/Demerier/dsh-image-forge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "qwen",
    "qwen-image",
    "text-to-image",
    "image-edit",
    "image-generation",
    "comfyui"
  ],
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "resources/*.py",
    "cordis.yml",
    "README.md",
    "skill.md",
    "references",
    "docs/*.md"
  ],
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts",
    "test": "node test/ratio.test.mjs && node test/local-edit-budget.test.mjs && node test/surface.test.mjs && node test/api-e2e.test.mjs && node test/comfyui-e2e.test.mjs && node test/worker-lifecycle.test.mjs && node test/edit-e2e.test.mjs && node test/vram-gate.test.mjs && node test/settings.test.mjs && node test/package-contents.test.mjs",
    "test:live": "node test/live-worker-e2e.mjs",
    "test:live:edit": "node test/live-edit-e2e.mjs both",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
